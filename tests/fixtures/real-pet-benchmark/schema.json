{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Teddytututu/ai-bead-pattern/tests/fixtures/real-pet-benchmark/schema.json",
  "title": "Grouped Oxford-IIIT Pet benchmark manifest",
  "type": "object",
  "required": ["schemaVersion", "datasetId", "targetSizes", "modes", "splits", "samples"],
  "properties": {
    "schemaVersion": {"const": "real-pet-benchmark-v1"},
    "datasetId": {"type": "string"}, "datasetTitle": {"type": "string"},
    "datasetUrl": {"format": "uri"}, "citation": {"type": "string"}, "licenseNote": {"type": "string"},
    "targetSizes": {"type": "array", "items": {"enum": [24,32,48,64,80]}, "minItems": 5, "uniqueItems": true},
    "modes": {"type": "array", "items": {"enum": ["baseline","ablation-no-shape","ablation-area-resize"]}, "minItems": 1, "uniqueItems": true},
    "splits": {"type": "object", "required": ["development","holdout"], "additionalProperties": false, "properties": {"development":{"type":"integer"},"holdout":{"type":"integer"}}},
    "samples": {"type":"array", "minItems": 40, "items": {"$ref":"#/$defs/sample"}}
  },
  "additionalProperties": false,
  "$defs": {"sample": {"type":"object", "required":["sampleId","imageId","category","subjectKind","breedGroup","sourceGroup","split","sourceDataset","sourceUrl","license","imageArchivePath","trimapArchivePath","localPath","trimapPath","evaluationDimensions"], "properties": {
    "sampleId":{"type":"string"}, "imageId":{"type":"string"}, "category":{"const":"pet"}, "subjectKind":{"const":"pet"}, "breedGroup":{"type":"string"}, "sourceGroup":{"type":"string"}, "split":{"enum":["development","holdout"]}, "sourceDataset":{"type":"string"}, "sourceUrl":{"format":"uri"}, "license":{"type":"string"}, "imageArchivePath":{"type":"string"}, "trimapArchivePath":{"type":"string"}, "localPath":{"type":"string"}, "trimapPath":{"type":"string"}, "sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}, "trimapSha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}, "evaluationDimensions":{"type":"array","minItems":1,"items":{"type":"string"}}
  }, "additionalProperties": false}}
}
