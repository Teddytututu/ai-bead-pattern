page { background:#f6f5ef; color:#202b25; font-family:system-ui; }
.page { padding:32rpx; } .title { font-size:40rpx; font-weight:700; margin:12rpx 0 20rpx; }
.note { color:#647269; font-size:24rpx; line-height:1.6; margin:16rpx 0; }
button { font-size:28rpx; margin:16rpx 0; border-radius:16rpx; } .primary,.selected { background:#315b48; color:white; }
.source { width:100%; height:320rpx; } .controls { background:white; padding:24rpx; border-radius:20rpx; }
picker { padding:20rpx 0; } .status,.total { padding:24rpx 0; font-weight:600; } .error { color:#a8342c; padding:16rpx 0; }
.result { margin-top:24rpx; } .candidates,.downloads { display:flex; gap:12rpx; flex-wrap:wrap; } .candidates button,.downloads button { flex:1; min-width:160rpx; font-size:24rpx; }
.pattern { width:300px; height:300px; max-width:100%; margin:16rpx auto; background:white; }
.material { display:flex; align-items:center; gap:16rpx; padding:16rpx 4rpx; border-bottom:1rpx solid #d6dfd8; } .material text:last-child { margin-left:auto; }
.swatch { width:28rpx; height:28rpx; border:1rpx solid #aaa; border-radius:4rpx; }
