<view class="page">
  <view class="title">把照片变成拼豆图纸</view>
  <view class="note">图片将上传到配置的图纸服务处理，默认保留 24 小时。</view>
  <button bindtap="chooseImage" disabled="{{busy}}">选择图片</button>
  <image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFit" class="source" />
  <view class="controls">
    <picker range="{{paletteNames}}" value="{{paletteIndex}}" bindchange="changePalette" disabled="{{busy}}"><view>材料色卡：{{paletteNames[paletteIndex]}} ▾</view></picker>
    <picker range="{{sizes}}" value="{{sizeIndex}}" bindchange="changeSize" disabled="{{busy}}"><view>画布：{{sizes[sizeIndex]}} × {{sizes[sizeIndex]}} ▾</view></picker>
    <view>本张最多使用 {{maxColors}} 色</view>
    <slider min="1" max="{{colorLimit}}" value="{{maxColors}}" bindchange="changeColors" disabled="{{busy}}" activeColor="#315b48" />
  </view>
  <button class="primary" bindtap="generate" disabled="{{!imagePath || busy}}">上传并生成图纸</button>
  <view class="status">{{status}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{busy && jobId}}" bindtap="cancel">取消生成</button>
  <view class="result" hidden="{{!hasResult}}">
    <view class="candidates"><button wx:for="{{candidates}}" wx:key="id" data-index="{{index}}" bindtap="selectCandidate" class="{{selectedIndex === index ? 'selected' : ''}}">{{item.label}}</button></view>
    <canvas canvas-id="patternCanvas" class="pattern" />
    <view class="total">共 {{totalBeads}} 颗 · {{materials.length}} 色</view>
    <view wx:for="{{materials}}" wx:key="code" class="material"><view class="swatch" style="background:{{item.hex}}" /><text>{{item.code}}</text><text>{{item.count}} 颗</text></view>
    <view class="downloads"><button data-format="png" bindtap="exportFile">保存图纸</button><button data-format="csv" bindtap="exportFile">材料 CSV</button><button data-format="json" bindtap="exportFile">图纸 JSON</button></view>
    <view class="note">屏幕色值仅供参考，制作时请按色号核对实物。</view>
  </view>
</view>
