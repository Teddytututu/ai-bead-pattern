# Copy to .env in this directory. Never commit real credentials.
HOST=127.0.0.1
PORT=7105
PATTERN_DATA_DIR=./data
NODE_ENV=development
# Only enable for local development; forbidden in production.
PATTERN_DEV_AUTH=1
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional, deterministic generation does not require a model service.
REMBG_ENDPOINT=
# Required for non-loopback model endpoints; displayed before consent.
REMOTE_ANALYSIS_LABEL=
