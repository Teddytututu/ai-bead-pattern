{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Teddytututu/ai-bead-pattern/schemas/pixel-art-reading-record.schema.json",
  "title": "Pixel Art Close Reading Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "creator",
    "source",
    "url",
    "media_type",
    "language",
    "accessed_at",
    "access_status",
    "quality_grade",
    "topics",
    "techniques",
    "workflow_steps",
    "applicable_subjects",
    "canvas_scale",
    "failure_modes",
    "corrections",
    "anchors",
    "bead_mapping",
    "summary",
    "close_reading_status"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^PA-[0-9]{4}$" },
    "title": { "type": "string", "minLength": 1 },
    "creator": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "canonical_url": { "type": "string", "format": "uri" },
    "media_type": {
      "enum": ["article", "forum-post", "video", "official-doc", "paper", "book-chapter", "github-readme"]
    },
    "language": { "type": "string", "minLength": 2 },
    "published_at": { "type": ["string", "null"] },
    "accessed_at": { "type": "string", "format": "date" },
    "access_status": { "enum": ["full-text", "full-caption", "full-readme", "partial", "unavailable"] },
    "quality_grade": { "enum": ["A", "B", "C"] },
    "topics": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "techniques": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 8 } },
    "workflow_steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "applicable_subjects": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "canvas_scale": { "type": "string", "minLength": 1 },
    "failure_modes": { "type": "array", "items": { "type": "string", "minLength": 5 } },
    "corrections": { "type": "array", "items": { "type": "string", "minLength": 5 } },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "note"],
        "properties": {
          "locator": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 5 }
        }
      }
    },
    "bead_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "rule", "priority"],
      "properties": {
        "stage": { "enum": ["analysis", "structure", "palette", "grid", "refinement", "export", "evaluation"] },
        "rule": { "type": "string", "minLength": 8 },
        "priority": { "enum": ["high", "medium", "low"] }
      }
    },
    "summary": { "type": "string", "minLength": 30 },
    "close_reading_status": { "enum": ["qualified", "candidate", "rejected"] },
    "duplicate_of": { "type": ["string", "null"], "pattern": "^PA-[0-9]{4}$" },
    "notes": { "type": "string" }
  }
}
